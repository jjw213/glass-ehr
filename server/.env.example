# 복사해서 server/.env 로 저장한 뒤 값을 채우세요.  cp .env.example .env

# --- Oracle ---
DB_CLIENT=oracle
ORACLE_USER=GLASSHR
ORACLE_PASSWORD=change-me
# 호스트:포트/서비스명
#   Oracle 23ai Free → localhost:1521/FREEPDB1
#   Oracle 21c XE    → localhost:1521/XEPDB1
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# --- server ---
PORT=4000
TZ=Asia/Seoul
SESSION_HOURS=12
# HTTPS 로 서비스할 때 true
COOKIE_SECURE=false
# db:init 때 모든 계정에 넣을 초기 비밀번호
SEED_PASSWORD=1234

# Oracle 없이 로컬에서 돌려볼 때 (Node 22.13+ 내장 SQLite)
# DB_CLIENT=sqlite
