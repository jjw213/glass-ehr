<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version>
    <relativePath/>
  </parent>

  <groupId>com.glassehr</groupId>
  <artifactId>glass-ehr-backend</artifactId>
  <version>0.1.0</version>
  <name>glass-ehr-backend</name>
  <description>Glass HR 백엔드 (Spring Boot + JPA/MyBatis + Oracle)</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 테스트 JVM 기본 시간대(아래 surefire argLine). -->
    <test.timezone>Asia/Seoul</test.timezone>
    <mybatis-spring-boot.version>3.0.5</mybatis-spring-boot.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- 인사·조직 CRUD (docs/DECISIONS.md 2026-11-10) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- 근태·급여 집계, 기준값(적용시작일) 조회 (docs/DECISIONS.md 2026-11-10) -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>${mybatis-spring-boot.version}</version>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <!-- 테스트 JVM도 운영(GlassEhrApplication.main의 TimeZone.setDefault)과 같은 Asia/Seoul로 돌린다.
             CI 러너의 기본 시간대(UTC)에 따라 결과가 달라지지 않게 한다.
             저장 값은 JVM 시간대와 무관해야 하므로(#84) `mvn test -Dtest.timezone=UTC` 로 UTC JVM에서도 확인할 수 있다. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Duser.timezone=${test.timezone}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
