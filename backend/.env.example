# 복사해서 backend/.env 로 쓰세요. .env 는 커밋하지 않습니다.
# application.yml 의 spring.config.import 가 이 파일을 자동으로 읽습니다(따로 export 할 필요 없음).
# 같은 이름의 OS 환경변수가 있으면 환경변수가 우선합니다.
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USER=glass_ehr
DB_PASSWORD=change-me
PORT=8080

# 주민등록번호 암호화(docs/rrn-design.md). 아래 값은 비워 두고, 각자 새로 만든 키를 .env 에만 넣으세요.
# 키 만들기 예: openssl rand -base64 32
# RRN_ENC_KEYS 는 '버전:base64(32바이트)' 를 쉼표로 이어 씁니다(옛 버전 키를 남겨 두면 옛 레코드도 복호화됨).
# RRN_HMAC_KEY 는 암호화 키와 다른 키(base64, 32바이트 이상)여야 합니다.
RRN_ENC_KEYS=
RRN_CURRENT_KEY_VERSION=1
RRN_HMAC_KEY=
